{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assureloop.dev/schemas/release-manifest.v0.json",
  "title": "AssureLoop Release Manifest",
  "description": "Machine-readable contract for AssureLoop release evidence manifests.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "project",
    "product",
    "version",
    "target",
    "build_profile",
    "generated_at",
    "git",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "https://assureloop.dev/schemas/release-manifest.v0.json"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.0$"
    },
    "project": {
      "type": "string",
      "const": "AssureLoop"
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "build_profile": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "git": {
      "type": "object",
      "required": [
        "commit",
        "short_commit",
        "dirty"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "short_commit": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": true
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tool_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "sbom": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
